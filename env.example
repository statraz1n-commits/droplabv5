# Copy these variables into Render's Environment tab (or create a local .env file).
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/droplab.sqlite
# Choose a long random string (at least 32 characters) for production.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Initial local admin is xtc / Skeleton when ADMIN_PASSWORD is unset. CHANGE IT BEFORE PUBLIC DEPLOYMENT!
ADMIN_USERNAME=xtc
# ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD_ON_PUBLIC_RENDER
# Steam IDs can also be site admins after verified Steam OpenID login.
ADMIN_STEAM_IDS=
# Optional; enables fetching Steam nicknames/avatars after OpenID login.
STEAM_WEB_API_KEY=
